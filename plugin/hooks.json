{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "'{{brain}}' hook session-start || true", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "'{{brain}}' hook prompt || true", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "'{{brain}}' hook stop || true", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "'{{brain}}' hook session-end || true", "timeout": 5 }] }
    ]
  }
}
